# Yamtrack on Railway — environment variables
#
# Copy to .env only for local reference; Railway sets these from the
# template. Values marked "generated" are created at deploy time.

# --- Required (template variables) ---
# Django secret key. Generated at deploy time. Upstream's default is a
# publicly known value — never deploy with it.
SECRET=your-generated-50-char-secret
# Password for the auto-seeded admin account (username: admin).
YAMTRACK_ADMIN_PASSWORD=your-generated-admin-password
# Redis host, auto-wired from the redis companion service.
REDIS_HOST=redis.railway.internal

# --- Baked in the image (do not set unless overriding) ---
# REGISTRATION=False — open signup is closed; the seeded admin is the account.
# ADMIN_ENABLED=True — Django's /admin/ is enabled for user management.
# TZ=UTC

# --- Optional (upstream env vars — set on the service to use) ---
# URLS=https://yamtrack.example.com — CSRF trusted origins + allowed hosts.
#   Derived automatically at boot from RAILWAY_PUBLIC_DOMAIN when unset.
# YAMTRACK_INTERNAL_PORT=8000 — port nginx listens on inside the container.
#   Mapped automatically from Railway's PORT; only set to move it.
# YAMTRACK_ADMIN_USERNAME=admin — username of the seeded admin account.
# TMDB_API= — TMDB key for movies/TV (a shared default key ships upstream).
# TMDB_LANG=en-US — metadata language (ISO 639-1 + optional country code).
# TMDB_NSFW=False — include adult content in TMDB searches.
# MAL_API= — MyAnimeList key for anime/manga (shared default ships upstream).
# IGDB_ID= / IGDB_SECRET= — IGDB keys for games (shared defaults ship
#   upstream, low rate limit — bring your own for heavy use).
# HARDCOVER_API= — Hardcover key for books (shared default ships upstream;
#   custom values must include the "Bearer " prefix).
# COMICVINE_API= — ComicVine key for comics (shared default ships upstream).
# PUID=1000 / PGID=1000 — user/group the app files are owned by in-container.
# WEB_CONCURRENCY=1 — number of web server processes.
# TRACK_TIME=True — set False to disable time tracking.
# DEBUG=False — set True for debugging only.
# REDIS_PREFIX= — prefix for Redis keys when sharing one Redis instance.
# CELERY_REDIS_URL= — Celery broker URL (defaults to REDIS_URL).
# HEALTHCHECK_CELERY_PING_TIMEOUT=1 — timeout for the /health/ celery ping.
# DB_HOST= — set to use PostgreSQL instead of the default SQLite
#   (then also DB_NAME, DB_USER, DB_PASSWORD; see upstream docs).
